# Use the deployed backend URL in production (Vercel/Netlify/etc.).
# Local development typically uses http://localhost:5000.
# Example: https://jaskron-secure-ops-api.onrender.com
VITE_API_URL=http://localhost:5000

# Public URL of the deployed frontend (used for SEO canonical + Open Graph tags)
# Example: https://jaskron.vercel.app
VITE_SITE_URL=http://localhost:3000
