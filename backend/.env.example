# --- Core ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/jaskron-secure-ops
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Auth (REQUIRED in production — server refuses to boot without this) ---
JWT_SECRET=replace-with-a-long-random-string

# --- Dev convenience only ---
# Set to "true" to skip email OTP verification AND admin 2FA entirely — register
# and login work with just email + password, no codes needed. Ignored/blocked
# outside of local dev (NODE_ENV=production always requires real verification).
SKIP_EMAIL_VERIFICATION=false

# --- Email (Gmail — just an address + app password, no SMTP host/port to configure) ---
# EMAIL_USER is your Gmail address. EMAIL_PASS is a Gmail "App Password" —
# NOT your normal Gmail login password. Generate one at:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# If left unset, emails are just logged to the console instead of sent (dev-friendly default).
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM="JASKRON Secure Ops <your-email@gmail.com>"

# --- Payments (Razorpay) — leave unset to disable paid workshops ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI workshop advisor (optional — falls back to keyword matching if unset) ---
ANTHROPIC_API_KEY=

# --- Cloudinary (required for LMS lesson video uploads) ---
# Either set the single CLOUDINARY_URL from your Cloudinary dashboard...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or set these three instead (both styles work, CLOUDINARY_URL takes priority if both are set):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
